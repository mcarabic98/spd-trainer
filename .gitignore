# ============================================================
#  SPD Trainer — .gitignore
# ============================================================

# Официальная банка игры: распространяется автором игры,
# скачивается отдельно (см. README, раздел «Сборка»)
ShatteredPD-v*.jar

# Артефакты сборки трейнера (пересоздаются build-trainer.bat).
# Паттерн без ведущего слэша — отсекает build/ на любом уровне,
# включая выходные каталоги Gradle внутри game/
build/
dist/

# Локальные артефакты Gradle в исходниках игры
.gradle/
local.properties
game/metadata/.local

# Локальный клон исходников игры — только для навигации по коду
# при разработке (см. README «Разработка»); сборке не нужен
game/

# Лог запусков трейнера и любые другие логи
trainer.log
*.log

# Краш-дампы JVM
hs_err_pid*
replay_pid*

# IDE
.idea/
*.iml
.vscode/
*.swp
.project
.classpath
.settings/

# ОС
Thumbs.db
.DS_Store

# Компилированные классы (на случай ручной сборки мимо build/)
*.class
